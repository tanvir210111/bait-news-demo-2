{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/post/([0-9]+)",
      "dest": "/post/$1.html"
    },
    {
      "src": "/category/([a-zA-Z0-9_-]+)",
      "dest": "/category/$1.html"
    },
    {
      "src": "/search",
      "dest": "/search.html"
    },
    {
      "src": "/photo",
      "dest": "/photo.html"
    },
    {
      "src": "/video",
      "dest": "/video.html"
    },
    {
      "src": "/poll",
      "dest": "/poll.html"
    },
    {
      "src": "/reporter",
      "dest": "/reporter.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}